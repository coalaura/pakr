+/* One fixed-size slot per thread, never on the worker stack. Destroying the decoder
+ * after each use releases its variable-size backreference buffer. Analysis releases
+ * the slot before verification. Nested calls get independent, non-retained storage. */
+class SparseWindowBlock
+{
+    using Decoder = Block</* ENABLE_STATISTICS */ false>;
+    inline static thread_local std::optional<Decoder> storage;
+    std::unique_ptr<Decoder> nested;
+
+public:
+    SparseWindowBlock() :
+        nested( storage.has_value() ? std::make_unique<Decoder>() : nullptr ),
+        block( nested ? *nested : storage.emplace() )
+    {}
+
+    ~SparseWindowBlock()
+    {
+        if ( !nested ) {
+            storage.reset();
+        }
+    }
+
+    SparseWindowBlock( const SparseWindowBlock& ) = delete;
+    SparseWindowBlock& operator=( const SparseWindowBlock& ) = delete;
+
+    Decoder& block;
+};
+
