+/* Pakr drains bounded CPIO padding after the trailer to validate outer filters. */
+int
+pakr_archive_read_tail(struct archive *archive)
+{
+	struct archive_read *a = (struct archive_read *)archive;
+	struct cpio *cpio = a->format->data;
+	ssize_t available;
+	const unsigned char *bytes = __archive_read_ahead(a, 1, &available);
+	if (available < 0)
+		return (ARCHIVE_FATAL);
+	if (bytes == NULL)
+		return (ARCHIVE_EOF);
+	if (available > 65536)
+		available = 65536;
+	cpio->tail_bytes += available;
+	if (cpio->tail_bytes > 1048576) {
+		archive_set_error(archive, ARCHIVE_ERRNO_FILE_FORMAT, "Excessive cpio padding");
+		return (ARCHIVE_FATAL);
+	}
+	for (ssize_t index = 0; index < available; index++) {
+		if (bytes[index] != 0) {
+			archive_set_error(archive, ARCHIVE_ERRNO_FILE_FORMAT, "Invalid cpio padding");
+			return (ARCHIVE_FATAL);
+		}
+	}
+	if (__archive_read_consume(a, available) != available)
+		return (ARCHIVE_FATAL);
+	return (ARCHIVE_OK);
+}
