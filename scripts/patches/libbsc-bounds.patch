+// Bounds checks for untrusted CLI blocks. Wire representation is unchanged.
+thread_local const unsigned char * bsc_input_end = NULL;
+thread_local unsigned char * bsc_output_end = NULL;
+thread_local bool bsc_input_error = false;
+
+int bsc_coder_decode_block(const unsigned char *, unsigned char *, int);
+int bsc_lzp_decode_block(const unsigned char *, const unsigned char *, unsigned char *, int *, int, int);
+
+template <class Decode>
+static int bsc_decode_chunks(const unsigned char * input, int inputSize, unsigned char * output, int outputSize, Decode decode)
+{
+	if (inputSize < 1 || outputSize < 1) return LIBBSC_DATA_CORRUPT;
+	int count = input[0];
+	if (count == 0) return LIBBSC_DATA_CORRUPT;
+	if (count == 1)
+	{
+		bsc_input_end = input + inputSize;
+		bsc_output_end = output + outputSize;
+		return decode(input + 1, bsc_input_end, output);
+	}
+	int source = 1 + 8 * count;
+	int destination = 0;
+	if (source > inputSize) return LIBBSC_DATA_CORRUPT;
+	for (int block = 0; block < count; ++block)
+	{
+		int original, packed;
+		memcpy(&original, input + 1 + 8 * block, 4);
+		memcpy(&packed, input + 5 + 8 * block, 4);
+		if (original < 1 || packed < 1 || original > outputSize - destination || packed > inputSize - source) return LIBBSC_DATA_CORRUPT;
+		if (packed == original)
+		{
+			memcpy(output + destination, input + source, original);
+		}
+		else
+		{
+			bsc_input_end = input + source + packed;
+			bsc_output_end = output + destination + original;
+			int result = decode(input + source, bsc_input_end, output + destination);
+			if (result < 0) return result;
+			if (result != original) return LIBBSC_DATA_CORRUPT;
+		}
+		source += packed;
+		destination += original;
+	}
+	return source == inputSize ? destination : LIBBSC_DATA_CORRUPT;
+}
